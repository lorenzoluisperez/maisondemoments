{
  "name": "maison-de-moments",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start",
    "dev:sites": "node scripts/run-framework.mjs dev",
    "build:sites": "node scripts/run-framework.mjs build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:configure-role": "node --env-file=.env scripts/configure-database-role.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:verify": "node --env-file=.env scripts/verify-database.mjs",
    "storage:setup": "node --conditions=react-server --env-file=.env --import tsx scripts/setup-storage.ts",
    "catalog:seed": "node --conditions=react-server --env-file=.env --import tsx scripts/seed-catalog.ts",
    "media:work": "node --conditions=react-server --env-file=.env --import tsx scripts/process-media-jobs.ts",
    "media:verify": "node --conditions=react-server --env-file=.env --import tsx scripts/verify-media.ts",
    "guest:verify": "node scripts/verify-guest-budgets.mjs",
    "ops:restore-drill": "node --env-file=.env scripts/restore-drill.mjs",
    "check:full": "npm run check && npm run test:db && npm run db:verify && npm run media:verify && npm run build && npm run guest:verify"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@sentry/nextjs": "^10.74.0",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^3.2.7",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

# Application: localhost for local development, your deployed HTTPS origin later.
NEXT_PUBLIC_APP_URL=http://localhost:5173
# Public ordering contact links. Use real HTTPS page/profile URLs when ready.
# Until set, the site shows labeled Facebook and Instagram placeholders.
FACEBOOK_PAGE_URL=
INSTAGRAM_PROFILE_URL=
# Supabase transaction-pooler URL for the least-privilege maison_app role.
DATABASE_URL=
# Supabase session-pooler URL for migrations only. Do not expose at runtime.
MIGRATION_DATABASE_URL=

# Supabase Auth and Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Deferred wedding checkout. The public showcase blocks commerce in code;
# leave these unset and COMMERCE_CHECKOUT_ENABLED=false for this release.
# PayMongo Dashboard > Developers > API Keys: copy the TEST secret key for development.
# Put actual keys only in ignored environment files or server settings,
# never in this example file or a NEXT_PUBLIC_ variable.
PAYMONGO_SECRET_KEY=
# Keep false until test checkout, prices, terms, and webhook handling are ready.
COMMERCE_CHECKOUT_ENABLED=false
# Currently required by checkout; review the privacy notice before enabling.
COMMERCE_ANALYTICS_ENABLED=false
# PayMongo Dashboard > Developers > Webhooks > your TEST endpoint > Signing secret.
# Create the endpoint for https://YOUR-TEST-SITE/api/webhooks/paymongo and subscribe to
# checkout_session.payment.paid. PayMongo needs a publicly reachable HTTPS callback.
# This is different from the API secret key.
PAYMONGO_WEBHOOK_SECRET=
# List only the methods active for this PayMongo account; QR Ph is the likely
# starting method for an activated Individual account. Confirm in live mode.
# PayMongo warns test QR Ph codes can process real transfers if scanned. During
# testing, use its test_url simulation, never a banking/e-wallet scan.
PAYMONGO_PAYMENT_METHODS=qrph
# Your own published, versioned HTTPS pages. Do not use placeholder policy text.
COMMERCE_TERMS_URL=
COMMERCE_CANCELLATION_URL=
# Your own accurate customer-facing tax/invoice statement, based on your setup.
COMMERCE_TAX_NOTICE=

# Application-generated secrets, not values from PayMongo or Supabase.
# Generate separate random values for each environment, for example:
# openssl rand -base64 48
# Protected invocation of bounded background-job processing.
BACKGROUND_JOB_SECRET=
# Bearer secret for the scheduled /api/internal/operations endpoint.
CRON_SECRET=

# Guest bearer credentials
# Use different random values per environment. Generate the encryption key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_TOKEN_PEPPER=replace-with-at-least-32-random-characters
GUEST_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-value

# Delivery and monitoring. Resend API key: Resend Dashboard > API Keys.
RESEND_API_KEY=replace-me
# A sender address on a domain verified in Resend. This is separate from
# Supabase Auth's email-code template, which must display {{ .Token }}.
EMAIL_FROM="Maison de Moments <invitations@example.com>"
# Optional server-side monitoring: Sentry project DSN.
SENTRY_DSN=

# Launch/restore gate only: a separate S3-compatible storage provider and bucket.
# Obtain endpoint, region, bucket, and access keys from that provider. Do not use
# the primary Supabase Storage project for the independent backup.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false

# Restore drill only: URL of an isolated, disposable PostgreSQL database.
# Never point this at the app's development or production database.
RESTORE_DATABASE_URL=

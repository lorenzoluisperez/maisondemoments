# Application
NEXT_PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:password@localhost:5432/maison_de_moments

# Supabase Auth and Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Guest bearer credentials
# Use different random values per environment. Generate the encryption key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_TOKEN_PEPPER=replace-with-at-least-32-random-characters
GUEST_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-value

# Delivery and monitoring
RESEND_API_KEY=replace-me
SENTRY_DSN=
